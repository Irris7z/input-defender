{
  "manifest_version": 3,
  "name": "Input Defender",
  "version": "0.3.0",
  "minimum_chrome_version": "119",
  "description": "入力値を読まず、フォームの変更や入力直後の外部通信などの不審な挙動を検知します。",
  "permissions": ["storage", "webRequest"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_popup": "popup.html", "default_title": "Input Defender"},
  "icons": {"16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png"},
  "content_scripts": [
    {"matches": ["http://*/*", "https://*/*"], "js": ["main-world.js"], "run_at": "document_start", "world": "MAIN", "all_frames": true},
    {"matches": ["http://*/*", "https://*/*"], "js": ["isolated-world.js"], "run_at": "document_start", "world": "ISOLATED", "all_frames": true}
  ],
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'"}
}
